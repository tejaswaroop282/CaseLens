# Copy to .env (gitignored) and fill in. Never commit .env.
# Every variable is read only in backend/app/config.py.

# --- Model provider (decision D18) ---
# gemini = Google AI Studio API (used now); bedrock = AWS Bedrock (planned production path, see D11)
LLM_PROVIDER=gemini
# Client-side cap on chat requests per minute (free tiers limit this); 0 = no cap
LLM_REQUESTS_PER_MINUTE=8

# --- Gemini (key from aistudio.google.com; never commit it) ---
GEMINI_API_KEY=
GEMINI_LLM_ID=gemini-2.5-flash
GEMINI_EMBED_ID=gemini-embedding-001
# 0 = no hidden reasoning tokens, so answers fit in LLM_MAX_TOKENS
GEMINI_THINKING_BUDGET=0

# --- AWS (only S3, IAM, Bedrock) ---
AWS_REGION=ap-south-1
AWS_PROFILE=
S3_BUCKET=

# --- Bedrock (used when LLM_PROVIDER=bedrock) ---
# One small chat model, in-region (decision D11). Copy the exact id from the Bedrock console.
BEDROCK_LLM_ID=
BEDROCK_EMBED_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=512
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0
# Optional JSON passed as additionalModelRequestFields (only if the smoke test shows it is needed)
LLM_EXTRA_REQUEST_FIELDS=

# --- Token budget (hard stops, enforced in code) ---
LLM_TOKEN_BUDGET_INPUT=1500000
LLM_TOKEN_BUDGET_OUTPUT=300000
EMBED_TOKEN_BUDGET=400000
MAX_LLM_CALLS_PER_CASE=6

# --- Storage ---
MONGO_URI=mongodb://localhost:27017/caselens
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=reg_docs

# --- API (decisions are forwarded to this server's mock case system route) ---
API_BASE_URL=http://localhost:8000
# Origins allowed to call the API (the React dev server). Comma-separated.
CORS_ORIGINS=http://localhost:5173

# --- LangSmith (set LANGSMITH_TRACING=false to run without it) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=caselens

# --- Data slice and guards ---
SLICE_HOURS=24
MAX_ROWS=
KEEP_LOCAL_RAW=false
MONGO_MAX_GB=1
DISK_BUDGET_GB=10
MAX_ALERTS=5000

# --- Investigation ---
TYPOLOGY_TOP_K=4
PROMPT_VERSION=v1
RANDOM_SEED=42
ID_PATTERN=\b[0-9A-F]{8,12}\b
